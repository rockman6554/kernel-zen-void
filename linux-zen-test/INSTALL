# INSTALL for linux-zen-test
# The kernel is installed with LOCALVERSION="-zentest", so its modules live under
# /usr/lib/modules/*zentest*. We detect that path dynamically instead of hardcoding
# a version, so this script stays correct across rebuilds.
case "$ACTION" in
post)
	KVER=$(ls -1 /usr/lib/modules 2>/dev/null | grep -E 'zentest' | head -n1)
	if [ -z "$KVER" ]; then
		echo "linux-zen-test: could not find installed *zentest* kernel modules" >&2
		exit 1
	fi

	# Register the modules for this kernel
	depmod "$KVER"

	# Generate initramfs with dracut
	dracut --force /boot/initramfs-"$KVER".img "$KVER"

	# Update GRUB (if used) so the new test entry shows up
	if command -v grub-mkconfig >/dev/null 2>&1; then
		grub-mkconfig -o /boot/grub/grub.cfg
	fi
	;;
esac
